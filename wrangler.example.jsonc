{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pasti",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_YOUR_WORKER_HOST",
    "GOOGLE_CLIENT_ID": "901676386364-sb9arevdisg86hca62bdeb8ubu8dm396.apps.googleusercontent.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pasti-auth",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "server/migrations"
  }]
}
